{
    "editor.wordWrap": "off",
    "editor.overviewRulerBorder": false,
    "dart.renameFilesWithClasses": "always",
    "[dart]": {
        "editor.defaultFormatter": "Dart-Code.dart-code"
    },
    "editor.formatOnType": true,
    "cSpell.enabled": true,
    "cSpell.diagnosticLevel": "Warning",
    "cSpell.language": "en",
    "cSpell.files": [
        "lib/**",
        "example/**"
    ],
    "cSpell.words": [
        "ADEFGHIJKLMNOPQRSTUVWXYZ",
        "Alnum",
        "ARGB",
        "Ascii",
        "binarization",
        "binarize",
        "binarized",
        "colorpicker",
        "colour",
        "debouce",
        "Debouncer",
        "dedupe",
        "explorable",
        "fcheck",
        "grayscale",
        "LTRB",
        "LTWH",
        "Luma",
        "matosinhos",
        "Otsu",
        "portugale",
        "prefs",
        "Rgba",
        "subgrid",
        "subgrids",
        "sublist",
        "Templatize",
        "textify",
        "Textifying",
        "Upscaling",
        "Upsert",
        "vsync",
        "vteam",
        "webp"
    ],
    "terminal.integrated.wordWrap": false,
    "explorer.fileNesting.enabled": true,
    "editor.formatOnSave": true,
    "workbench.editor.closeOnFileDelete": true,
    "cmake.ignoreCMakeListsMissing": true,
    "explorer.fileNesting.patterns": {
        "pubspec.yaml": "changelog.md, readme.md, privacy.html, license, .metadata, pubspec.lock, analysis_options.yaml, devtools_options.yaml, graph.dot, graph.svg, .gitignore",
    },
    "debug.console.wordWrap": false,
    "terminal.integrated.scrollback": 10000,
    "testing.automaticallyOpenPeekView": "never",
    "testing.defaultGutterClickAction": "run",
    "testing.gutterEnabled": true,
    "testing.openTesting": "neverOpen",
    "dart.testAdditionalArgs": [
        "--no-wrap"
    ],
    "testing.automaticallyOpenTestResults": "neverOpen"
}